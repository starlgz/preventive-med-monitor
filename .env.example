# ==========================================
# 全国预防医学事业单位招聘实时监测系统 配置示例
# ==========================================

# 基础服务配置
APP_NAME=全国预防医学事业单位招聘实时监测系统
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 数据库配置 (SQLite 单文件)
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db

# 调度配置 (分钟)
SCHEDULER_INTERVAL_MINUTES=30

# Telegram 通知配置 (后续 Phase 启用)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI 研判 API 配置 (OpenAI 兼容协议, 后续 Phase 启用)
AI_API_KEY=
AI_BASE_URL=https://api.jdcar.eu.org/v1
AI_MODEL=gemini-3-flash
